#!/usr/bin/env bash
# pre-push: (1) vendored-conformance-vector drift guard (2026-07-18) + (2) public-content hygiene forbid-gate (2026-07-27).
#
# WHY: tests/vectors/ are READ-ONLY pinned copies of r2-specifications' canonical
# test-vectors (see crates/r2-hive-bin/tests/vectors/_SYNC.md). A drift guard that
# is never INVOKED is the SAME false-green class as a silent exit-0 — so this
# INVOKES ci/check-vendored-vectors.sh on every push and BLOCKS if the vendored
# copy has drifted (or canon is unreachable — fail-closed).
#
# INTEGRATION (do NOT use core.hooksPath — it would disable the FLEET secret-scan
# hook at .git/hooks/pre-push). This file is installed as .git/hooks/pre-push.local,
# the extension point the fleet secret-scan hook `exec`s after its own scan passes.
# `scripts/setup-hooks.sh` wires it up (symlink → this tracked source) so edits here
# take effect without re-installing.
#
# BYPASS (rare, deliberate — e.g. a siblingless push):  git push --no-verify
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel 2>/dev/null)"
# When run as .git/hooks/pre-push.local the BASH_SOURCE dir is .git/hooks; resolve
# the repo root robustly via git.
[ -z "$ROOT" ] && ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
GUARD="$ROOT/ci/check-vendored-vectors.sh"

if [ ! -x "$GUARD" ]; then
  echo "pre-push: vendored-vector guard missing ($GUARD) — cannot verify; failing closed." >&2
  echo "  bypass (deliberate): git push --no-verify" >&2
  exit 1
fi

echo "pre-push: verifying vendored conformance vectors vs canon…"
if ! "$GUARD" --strict; then
  echo "" >&2
  echo "✗ PUSH BLOCKED — vendored conformance vectors have DRIFTED from canon (or canon is unreachable)." >&2
  echo "  Re-vendor per crates/r2-hive-bin/tests/vectors/_SYNC.md, then re-run the suite." >&2
  # THE BYPASS IS CONDITIONAL (supervisor ruling 2026-07-28). The defect was never the escape — it was the
  # escape being ADVERTISED AT THE MOMENT OF MAXIMUM PRESSURE, reaching its reader exactly when they are
  # blocked, in a hurry, and least able to weigh whether the exemption applies. The message was arguing for
  # the wrong side. If canon is REACHABLE, this host can chase it and the exemption does NOT apply, so the
  # line is not printed at all. The cost is stated either way: a bypass whose consequence is unnamed reads
  # as a supported option.
  _canon="${R2_SPECS_VECTORS:-$(git rev-parse --show-toplevel)/../r2-specifications/testing/test-vectors}"
  if [ -d "$_canon" ]; then
    echo "  Canon IS reachable on this host ($_canon) — so this is real drift, not an unreachable sibling." >&2
    echo "  There is no applicable bypass: re-vendor. Pushing regardless would carry vectors that NOTHING" >&2
    echo "  has compared against canon." >&2
  else
    echo "  Canon NOT found at: $_canon" >&2
    echo "  BYPASS EXISTS ONLY FOR THIS CASE — a host that cannot reach canon: git push --no-verify" >&2
    echo "  SCOPE: using it on a host that CAN reach canon is a false green. COST either way: your push" >&2
    echo "  carries vendored vectors nothing has compared against canon, and no later gate will catch it." >&2
  fi
  exit 1
fi
echo "pre-push: vendored vectors match canon — OK."

# ── public-content hygiene (g23 forbid-gate) ──────────────────────────────────────────────
# WHY WIRED HERE (supervisor ruling 2026-07-27): the hygiene gate is HARDFAIL, but a hardfail gate
# that nothing invokes at push time is A GATE NOTHING RUNS — the same false-green class as a silent
# exit-0, and it already bit us (a commit pushed while the gate FAILED because pre-push did not run
# it; manual discipline decays silently, a mechanism fails loudly). So INVOKE it here and BLOCK on
# failure. The gate self-excludes ONLY its own file (narrow) so describing a forbidden class does not
# self-trip; describe the CLASS not the INSTANCE in any tracked file.
HYG="$ROOT/ci/public-hygiene.sh"
if [ ! -x "$HYG" ]; then
  echo "pre-push: public-hygiene gate missing ($HYG) — cannot verify; FAILING CLOSED." >&2
  echo "  a scanner with ABSENT INPUTS must fail, never pass. restore it: git checkout -- ci/public-hygiene.sh" >&2
  echo "  bypass (deliberate): git push --no-verify" >&2
  exit 1
fi
# CONDITION-1 forward note: if the pattern/denylist is ever externalised to a gitignored file, the
# gate ITSELF MUST fail-closed when that file is absent (a fresh clone lacks it → empty-corpus green).
# Today the patterns are inline in the gate, so a present+executable gate is a present-inputs gate.
echo "pre-push: public-content hygiene…"
if ! "$HYG"; then
  echo "" >&2
  echo "✗ PUSH BLOCKED — public-content-hygiene FAILED (forbidden host name / MAC / device tail / captured value)." >&2
  echo "  Scrub per the g23 convention: role tokens (<build-host>/<rig-host>/<scrubbed-ip>…), describe the CLASS not the INSTANCE." >&2
  echo "  Deliberate bypass (rare): git push --no-verify" >&2
  exit 1
fi
exit 0
